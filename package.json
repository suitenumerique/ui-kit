{
  "name": "gouvfr-lasuite-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "resolutions": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "csstype": "3.1.3"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:ct": "turbo run test:ct",
    "storybook": "turbo run storybook --filter=@gouvfr-lasuite/ui-components",
    "build-storybook": "turbo run build-storybook --filter=@gouvfr-lasuite/ui-components",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "check-locales": "yarn workspace @gouvfr-lasuite/ui-components check-locales",
    "generate-icons": "yarn workspace @gouvfr-lasuite/ui-components generate-icons",
    "generate-test-pdfs": "yarn workspace @gouvfr-lasuite/ui-components generate-test-pdfs",
    "scalingo-postbuild": "yarn build && yarn build-storybook"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "prettier": "3.5.3",
    "turbo": "2.5.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "yarn@1.22.22",
  "volta": {
    "node": "24.19.0",
    "yarn": "1.22.22"
  }
}
