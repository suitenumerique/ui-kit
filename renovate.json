{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>suitenumerique/ci//renovate/default",
    ":approveMajorUpdates"
  ],
  "dependencyDashboard": true,
  "separateMajorMinor": true,
  "prConcurrentLimit": 4,
  "packageRules": [
    {
      "description": "Dependencies shipped to consumers: pair the PR with a changeset",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "groupName": "published js dependencies"
    }
  ]
}
