{
  "name": "@gouvfr-lasuite/ui-components",
  "version": "1.3.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "**/pdfPolyfills.*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js",
      "require": "./dist/icons.cjs"
    },
    "./style": "./dist/style.css",
    "./fonts/material-icons": "./dist/fonts/material-icons.css",
    "./sass/fonts/material-icons": "./dist/sass/material-icons.scss",
    "./fonts/roboto": "./dist/fonts/roboto.css",
    "./sass/fonts/roboto": "./dist/sass/roboto.scss",
    "./fonts/marianne": "./dist/assets/fonts/Marianne/Marianne-font.css"
  },
  "scripts": {
    "dev": "yarn storybook",
    "build": "yarn build-theme && tsc && vite build && yarn build-assets",
    "check-locales": "tsx scripts/check-locales.ts",
    "build-theme": "cunningham -g css,scss,ts -o src --utility-classes && shx cp src/cunningham-tokens.scss src/cunningham-tokens-sass.scss",
    "build-assets": "yarn build-fonts && yarn build-material-icons",
    "build-fonts": "vite build -c vite.fonts.config.mts && shx mkdir -p dist/sass && shx mkdir -p dist/assets && shx cp src/fonts.scss dist/sass/roboto.scss && shx cp -R src/assets/fonts dist/assets/fonts",
    "build-material-icons": "vite build -c vite.icons.config.mts && shx mkdir -p dist/sass && shx cp src/icons.scss dist/sass/material-icons.scss",
    "lint": "eslint .",
    "test": "vitest run",
    "pretest:ct": "yarn prepare-test-assets",
    "test:ct": "playwright test -c playwright.config.ts",
    "test:ct:ui": "playwright test -c playwright.config.ts --ui",
    "prestorybook": "yarn prepare-test-assets",
    "storybook": "storybook dev -p 6006",
    "prebuild-storybook": "yarn prepare-test-assets",
    "build-storybook": "storybook build -o ../../storybook-static",
    "prepare-test-assets": "yarn copy-pdf-worker && yarn generate-test-pdfs",
    "copy-pdf-worker": "shx cp ../../node_modules/pdfjs-dist/build/pdf.worker.mjs public/pdf.worker.mjs && shx rm -rf public/wasm public/standard_fonts public/cmaps && shx cp -r ../../node_modules/pdfjs-dist/wasm ../../node_modules/pdfjs-dist/standard_fonts ../../node_modules/pdfjs-dist/cmaps public/",
    "generate-icons": "tsx scripts/generate-icons.ts",
    "generate-test-pdfs": "node scripts/generate-test-pdfs.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@fontsource-variable/roboto-flex": "5.2.5",
    "@fontsource/material-icons": "5.2.5",
    "@fontsource/material-icons-outlined": "5.2.5",
    "@gouvfr-lasuite/integration": "1.0.2",
    "@gouvfr-lasuite/ui-tokens": "3.2.0",
    "@internationalized/date": "3.12.0",
    "@react-aria/calendar": "3.9.5",
    "@react-aria/datepicker": "3.16.1",
    "@react-aria/i18n": "3.12.16",
    "@react-stately/calendar": "3.9.3",
    "@react-stately/datepicker": "3.16.1",
    "@tanstack/react-table": "8.21.3",
    "classnames": "2.5.1",
    "clsx": "2.1.1",
    "cmdk": "1.0.4",
    "deepmerge": "4.3.1",
    "downshift": "9.0.9",
    "react-arborist": "3.4.3",
    "react-aria": "3.47.0",
    "react-aria-components": "1.16.0",
    "react-modal": "3.16.3",
    "react-resizable-panels": "4.12.2",
    "react-stately": "3.45.0",
    "react-toastify": "11.1.0",
    "react-virtualized": "9.22.6",
    "react-pdf": "10.1.0",
    "read-excel-file": "9.3.1",
    "use-resize-observer": "9.1.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5",
    "react": "^19.1.2",
    "react-dom": "^19.1.2"
  },
  "devDependencies": {
    "@babel/core": "7.27.1",
    "@babel/plugin-proposal-decorators": "7.29.7",
    "@babel/plugin-proposal-export-default-from": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@chromatic-com/storybook": "3.2.8",
    "@faker-js/faker": "10.6.0",
    "@hookform/resolvers": "5.9.2",
    "@playwright/experimental-ct-react": "1.62.1",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "8.6.19",
    "@storybook/addon-actions": "8.6.19",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/addon-links": "8.6.19",
    "@storybook/addon-onboarding": "8.6.19",
    "@storybook/blocks": "8.6.14",
    "@storybook/preset-scss": "1.0.3",
    "@storybook/react": "8.6.19",
    "@storybook/react-vite": "8.6.19",
    "@storybook/test": "8.6.15",
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "@svgr/plugin-prettier": "8.1.0",
    "@svgr/plugin-svgo": "8.1.0",
    "@tanstack/react-query": "5.104.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-modal": "3.16.3",
    "@types/react-virtualized": "9.22.4",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-c8": "0.33.0",
    "@vitest/ui": "4.1.12",
    "babel-loader": "10.1.1",
    "chromatic": "11.29.0",
    "css-loader": "7.1.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-storybook": "0.12.0",
    "glob": "11.1.0",
    "globals": "15.15.0",
    "jsdom": "26.1.0",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "remark-gfm": "4.0.1",
    "sass": "1.105.2",
    "sass-loader": "16.0.8",
    "shx": "0.4.0",
    "storybook": "8.6.17",
    "style-loader": "4.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "6.4.3",
    "vite-plugin-dts": "4.5.4",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.1.12",
    "vitest-fetch-mock": "0.4.5",
    "yup": "1.7.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
